#!/bin/sh
# Pre-commit hook to run unit tests before committing

echo "Running Unit Tests..."
npm test

# Capture the exit code of the test command
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo "❌ Unit tests failed. Commit aborted."
  exit 1
fi

echo "✅ Unit tests passed. Proceeding with commit."
exit 0
