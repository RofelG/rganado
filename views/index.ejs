<!doctype html>
<html lang="en">
<head>
  <% if (tagId) { %>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= tagId %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', '<%= tagId %>');
  </script>
  <% } %>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Rofel Ganado is a full-stack web developer working across web applications, Linux, and infrastructure.">
  <title>Rofel Ganado | Full-Stack Developer</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body id="top">
  <nav class="navbar navbar-expand-md navbar-dark site-nav">
    <div class="container">
      <a class="navbar-brand" href="#top"><span class="accent-text">>_</span> RGANADO</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav-links" aria-controls="nav-links" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="nav-links">
        <div class="navbar-nav ms-auto">
          <a class="nav-link" href="#about">About</a>
          <a class="nav-link" href="#projects">Projects</a>
          <a class="nav-link" href="#homelab">Homelab</a>
          <a class="nav-link" href="#contact">Contact</a>
        </div>
      </div>
    </div>
  </nav>
  <header class="hero-container">
    <div class="hero-video-container">
      <video class="hero-vid" playsinline autoplay muted loop preload="metadata" aria-hidden="true">
        <source src="/img/hero.webm" type="video/webm">
        <source src="/img/hero.mp4" type="video/mp4">
      </video>
    </div>
    <div class="container hero-content">
      <p class="hero-kicker">FULL-STACK DEVELOPER · MISSISSAUGA, ON</p>
      <h1>Hello, I'm <span class="accent-text">Rofel.</span></h1>
      <h2>Web Developer<span class="accent-text">_</span></h2>
      <p>I build useful web experiences and the systems that help them run.</p>
      <a class="hero-button" href="#projects">View projects <span aria-hidden="true">↘</span></a>
    </div>
  </header>
  <main>
    <section class="section about-section" id="about">
      <div class="container">
        <div class="row g-5">
          <div class="col-lg-6">
            <p class="section-kicker">01 / ABOUT</p>
            <h2>From the interface<br>to the <span class="accent-text">infrastructure.</span></h2>
            <p>
              I'm a full-stack developer with over six years of professional experience building web applications, 
              shaping technical direction, and helping teams deliver. I enjoy bringing together thoughtful interfaces, 
              reliable backend systems, and practical infrastructure.
            </p>
            <p>At The Design Cell, I work across application architecture, RESTful APIs, deployments, 
              and Linux administration. I've also led the adoption of AI-assisted development and agentic workflows.
            </p>
          </div>
          <div class="col-lg-6">
            <p class="section-kicker">WHAT I WORK WITH</p>
            <h3>Tools of the trade<span class="accent-text">.</span></h3>
            <div class="skills">
              <span>PHP</span>
              <span>Laravel</span>
              <span>JavaScript</span>
              <span>HTML & SCSS</span>
              <span>RESTful APIs</span>
              <span>MySQL</span>
              <span>Docker</span>
              <span>Linux</span>
              <span>NGINX</span>
              <span>Jenkins</span>
              <span>AWS</span>
              <span>Git</span>
            </div>
            <p class="skills-note">
              From modernizing existing applications to building deployment workflows and 
              exploring native iOS in my personal projects.
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="section projects-section" id="projects">
      <div class="container">
        <p class="section-kicker">02 / SELECTED PROJECTS</p>
        <div class="section-heading"><div>
          <h2>Things I've <span class="accent-text">made.</span></h2>
          <p>Experiments, useful tools, and a little creative coding.</p>
        </div>
        <a href="https://github.com/RofelG" class="section-link">More on GitHub ↗</a>
      </div>
      <div class="project-grid">
        <% projects.forEach((project) => { %>
        <a href="<%= project.href %>" class="project-card card-spring">
          <% if (project.image) { %>
          <div class="project-image <%= project.imageClass %>">
            <img src="<%= project.image %>" alt="<%= project.imageAlt %>" loading="lazy">
          </div>
          <% } else { %>
          <div class="project-image project-image-code" aria-hidden="true">
            <span>&lt;video&gt;</span><strong>▶</strong><span>&lt;/video&gt;</span>
          </div>
          <% } %>
          <div class="project-content">
            <p class="project-type"><%= project.type %></p>
            <h3><%= project.name %> <span>↗</span></h3>
            <p><%= project.description %></p>
            <div class="tags">
              <% project.tags.forEach((tag) => { %><span><%= tag %></span><% }); %>
            </div>
          </div>
        </a>
        <% }); %>
      </div>
    </section>
    <section class="section homelab-section" id="homelab">
      <div class="container">
        <p class="section-kicker">03 / PERSONAL INFRASTRUCTURE</p>
        <div class="row g-5">
          <div class="col-lg-5">
            <h2>My <span class="accent-text">homelab.</span></h2>
            <p>
              A place to learn by running real services. I use my home setup to explore storage, 
              networking, and self-hosted applications - and to troubleshoot the details that make them work together.
            </p>
            <div class="terminal" aria-label="Homelab tools">
              <span>$ whoami</span><strong>curious builder_</strong><span>$ cat homelab.txt</span><strong>storage · dns · services</strong>
            </div>
          </div>
          <div class="col-lg-7">
            <div class="lab-list">
              <article><span class="lab-number">01</span><div><h3>TrueNAS SCALE</h3><p>Operating Docker Compose services and working through storage mounts, persistent volumes, permissions, and service dependencies.</p></div></article>
              <article><span class="lab-number">02</span><div><h3>Pi-hole &amp; DNS</h3><p>Configuring DNS and internal hostnames, and troubleshooting name resolution and connectivity.</p></div></article>
              <article><span class="lab-number">03</span><div><h3>NGINX Proxy Manager</h3><p>Routing services through a reverse proxy and working through TLS and port mapping.</p></div></article>
              <article><span class="lab-number">04</span><div><h3>Docker Compose</h3><p>Running and maintaining self-hosted services, from startup to storage and networking.</p></div></article>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <footer id="contact"><div class="container footer-inner"><div><a class="footer-brand" href="#top"><span class="accent-text">&gt;_</span> Rofel Ganado</a><p>Full-stack developer · Builder · Homelab enthusiast</p></div><div class="footer-links"><a href="mailto:rofelganado@gmail.com">Email ↗</a><a href="https://github.com/RofelG">GitHub ↗</a><a href="https://www.linkedin.com/in/rofel-ganado/">LinkedIn ↗</a></div></div></footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  <script src="/js/index.js"></script>
</body>
</html>
